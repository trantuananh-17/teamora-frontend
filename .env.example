# Server-side only. The browser never sees this — it reaches the backend
# through this app's own /api/* proxy.
TEAMORA_API_URL=http://localhost:8080

# Client-readable, served through EnvScript -> window.__env.
APP_BASE_URL=http://localhost:3000

# Ragenta chat bubble on the employee shell. All server-side; unset hides it.
# The key is publishable. The identity secret comes from the widget's
# "Identify signed-in visitors" panel and must stay on the server.
RAGENTA_WIDGET_SRC=https://staging-frontend.ragenta.cloud/widget.js
RAGENTA_WIDGET_KEY=
RAGENTA_IDENTITY_SECRET=
